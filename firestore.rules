rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Authorized administrator check (supports Google login or admin doc)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "palakolanumalleswari2@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Student Registration Path
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId)
        && incoming().keys().hasAll(['fullName', 'rollNumber', 'email', 'quizId'])
        && incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 100
        && incoming().rollNumber is string && incoming().rollNumber.size() >= 2 && incoming().rollNumber.size() <= 50;
      allow delete: if isAdmin();
    }

    // Quiz Configuration & Operational Settings
    match /quizSettings/{quizId} {
      allow get, list: if true;
      allow create, update: if isValidId(quizId);
      allow delete: if isAdmin();
    }

    // Competition Sessions
    match /quizSessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if isValidId(sessionId);
      allow delete: if isAdmin();
    }

    // Student Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow get, list: if true;
      allow create, update: if isValidId(attemptId);
      allow delete: if isAdmin();
    }

    // Quiz Results - Generated and finalized
    match /quizResults/{resultId} {
      allow get, list: if true;
      allow create, update: if isValidId(resultId)
        && incoming().keys().hasAll(['resultId', 'rollNumber', 'fullName', 'score', 'totalMarks'])
        && incoming().score is number && incoming().score >= 0 && incoming().score <= 30
        && incoming().totalMarks == 30;
      allow delete: if isAdmin();
    }

    // Authorized Admins collection
    match /admins/{adminUid} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Audit Log for Organizer actions
    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && incoming().keys().hasAll(['logId', 'action', 'timestamp']);
      allow update, delete: if false; // Immutable audit log
    }
  }
}
